---
// Botón "volver a pegar": aparece solo cuando alguna etiqueta del grupo se movió.
import Icono from './Icono.astro';
import type { Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<button class="repegar" type="button" data-repegar>
  <Icono nombre="arrow-counter-clockwise" tamano={18} />
  {idioma === 'es' ? 'volver a pegar' : 'stick them back'}
</button>
