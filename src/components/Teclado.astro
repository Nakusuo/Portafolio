---
// Teclado "PORTAFOLIO": cada tecla escribe un fun fact en la pantallita.
// Se puede tocar o teclear con el teclado de verdad mientras la sección está a la vista.
import { funFacts } from '../data/contenido';
import type { Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const es = idioma === 'es';

const t = es
  ? {
      titulo: 'Teclea mi portafolio',
      bajada: 'Cada tecla guarda un dato sobre mí. Tócalas o escríbelas con tu teclado.',
      espera: 'presiona una tecla',
      teclas: 'Teclas con fun facts',
    }
  : {
      titulo: 'Type my portfolio',
      bajada: 'Every key hides a fact about me. Tap them or type them on your keyboard.',
      espera: 'press a key',
      teclas: 'Keys with fun facts',
    };
---

<section id="teclado" class="seccion contenedor teclado" data-total={funFacts.length}>
  <div class="texto">
    <h2 class="titulo-seccion"><span class="prompt">&gt;</span>{t.titulo}</h2>
    <p class="bajada">{t.bajada}</p>
  </div>

  <div class="consola" data-consola>
    <div class="aparato">
      <div class="frente">
        <div class="marco-pantalla">
          <div class="pantalla">
            <p class="estado-pantalla" aria-hidden="true">
              <span>fun_facts.exe</span>
              <span><span class="vistos">0</span>/{funFacts.length}</span>
            </p>
            <p class="salida" aria-live="polite">
              <span class="letra-actual" aria-hidden="true">&gt;</span>
              <span class="texto-salida">{t.espera}</span><span class="cursor" aria-hidden="true"></span>
            </p>
          </div>
        </div>

        <div class="panel" aria-hidden="true">
          <span class="led"></span>
          <span class="rejilla"></span>
          <span class="perilla"><span></span></span>
          <span class="modelo">FF-10</span>
        </div>
      </div>

      <div class="teclas" role="group" aria-label={t.teclas}>
        {
          funFacts.map((f, i) => (
            <button type="button" class:list={['tecla', `tono-${i % 5}`]} data-indice={i} data-letra={f.letra} data-fact={f.texto[idioma]}>
              <span>{f.letra}</span>
            </button>
          ))
        }
      </div>

      <p class="placa" aria-hidden="true">nakusu · {es ? 'hecho a mano' : 'handmade'} · 2026</p>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('#teclado');

  if (seccion) {
    const teclas = [...seccion.querySelectorAll<HTMLButtonElement>('.tecla')];
    const salida = seccion.querySelector<HTMLElement>('.texto-salida')!;
    const letraActual = seccion.querySelector<HTMLElement>('.letra-actual')!;
    const vistos = seccion.querySelector<HTMLElement>('.vistos')!;
    const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
    let reloj = 0;
    let aLaVista = false;
    // Para las letras repetidas (la O): cuál toca la próxima vez que se teclee
    const siguiente = new Map<string, number>();

    const escribir = (texto: string) => {
      clearTimeout(reloj);
      if (sinMovimiento.matches) {
        salida.textContent = texto;
        return;
      }
      let i = 0;
      const paso = () => {
        salida.textContent = texto.slice(0, ++i);
        if (i < texto.length) reloj = window.setTimeout(paso, 22);
      };
      paso();
    };

    const pulsar = (tecla: HTMLButtonElement) => {
      teclas.forEach((t) => t.classList.remove('activa'));
      tecla.classList.add('activa', 'vista');
      const n = seccion.querySelectorAll('.vista').length;
      vistos.textContent = String(n);
      // La perilla gira según cuántos datos ya descubriste; el LED parpadea
      seccion.style.setProperty('--avance', String(n / teclas.length));
      seccion.classList.remove('escribiendo');
      void seccion.offsetWidth;
      seccion.classList.add('escribiendo');
      letraActual.textContent = `${tecla.dataset.letra}>`;
      escribir(tecla.dataset.fact ?? '');
    };

    teclas.forEach((tecla) => tecla.addEventListener('click', () => pulsar(tecla)));

    // El aparato se inclina un poco hacia el ratón
    const consola = seccion.querySelector<HTMLElement>('[data-consola]');
    if (consola && !sinMovimiento.matches && matchMedia('(hover: hover)').matches) {
      consola.addEventListener('pointermove', (e) => {
        const caja = consola.getBoundingClientRect();
        consola.style.setProperty('--mx', (((e.clientX - caja.left) / caja.width) * 2 - 1).toFixed(3));
        consola.style.setProperty('--my', (((e.clientY - caja.top) / caja.height) * 2 - 1).toFixed(3));
      });
      consola.addEventListener('pointerleave', () => {
        consola.style.setProperty('--mx', '0');
        consola.style.setProperty('--my', '0');
      });
    }

    new IntersectionObserver(([e]) => (aLaVista = e.isIntersecting), { threshold: 0.4 }).observe(seccion);

    addEventListener('keydown', (e) => {
      if (!aLaVista || e.repeat || e.ctrlKey || e.metaKey || e.altKey) return;
      if ((e.target as HTMLElement).closest('input, textarea, [contenteditable], dialog')) return;
      const letra = e.key.toUpperCase();
      const mismas = teclas.filter((t) => t.dataset.letra === letra);
      if (!mismas.length) return;
      const n = siguiente.get(letra) ?? 0;
      siguiente.set(letra, (n + 1) % mismas.length);
      const tecla = mismas[n];
      tecla.classList.add('hundida');
      setTimeout(() => tecla.classList.remove('hundida'), 140);
      pulsar(tecla);
    });
  }
</script>

<style>
  .teclado {
    /* La pantalla es siempre oscura, como un tubo viejo, en modo claro y oscuro */
    --lcd: var(--term-fondo);
    --lcd-texto: var(--term-acento);
    --lcd-suave: rgb(227 169 59 / 0.5);
    /* Cuerpo del aparato: plástico color hueso de día, oliva oscuro de noche */
    --cuerpo: #e7e0d2;
    --cuerpo-luz: #fbf7f0;
    --cuerpo-canto: #c2b59c;
    --cuerpo-sombra: #8f8167;
    --avance: 0;

    display: grid;
    gap: 40px;
    justify-items: center;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .teclado {
      --cuerpo: #2a241e;
      --cuerpo-luz: #3a3229;
      --cuerpo-canto: #18140f;
      --cuerpo-sombra: #0d0b08;
    }
  }

  :global(:root[data-theme='dark']) .teclado {
    --cuerpo: #2a241e;
    --cuerpo-luz: #3a3229;
    --cuerpo-canto: #18140f;
    --cuerpo-sombra: #0d0b08;
  }

  .texto {
    max-width: 52ch;
  }

  @media (min-width: 960px) {
    .teclado {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      justify-items: start;
      text-align: left;
    }

    .consola {
      justify-self: end;
    }
  }

  /* ---------- El aparato, con grosor y un poco inclinado ---------- */
  .consola {
    --mx: 0;
    --my: 0;
    width: min(100%, 720px);
    perspective: 1400px;
    padding-bottom: 28px;
  }

  .aparato {
    position: relative;
    padding: clamp(16px, 3vw, 28px);
    border-radius: 22px 22px 26px 26px;
    background:
      radial-gradient(120% 80% at 20% 0%, var(--cuerpo-luz), transparent 60%),
      var(--cuerpo);
    /* El canto de abajo da el grosor; la sombra larga lo apoya en la mesa */
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.35),
      inset 0 -3px 0 rgb(0 0 0 / 0.08),
      0 6px 0 var(--cuerpo-canto),
      0 12px 0 var(--cuerpo-canto),
      0 18px 0 var(--cuerpo-sombra),
      0 50px 50px -20px rgb(0 0 0 / 0.45);
    transform: rotateX(calc(12deg + var(--my) * -4deg)) rotateY(calc(var(--mx) * 6deg));
    transform-origin: 50% 80%;
    transition: transform 0.6s var(--curva);
  }

  .frente {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(12px, 2.4vw, 22px);
    margin-bottom: clamp(16px, 3vw, 26px);
  }

  /* ---------- Pantalla tipo tubo ---------- */
  .marco-pantalla {
    padding: 10px;
    border-radius: 18px;
    background: #1f1a14;
    box-shadow:
      inset 0 2px 4px rgb(0 0 0 / 0.6),
      0 1px 0 rgb(255 255 255 / 0.25);
  }

  .pantalla {
    position: relative;
    min-height: 7.5em;
    padding: 14px 18px 18px;
    overflow: hidden;
    border-radius: 14px / 18px;
    background:
      repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 4px),
      radial-gradient(120% 120% at 50% 50%, #2a1f0c 0%, var(--lcd) 70%);
    box-shadow:
      inset 0 0 28px rgb(0 0 0 / 0.85),
      inset 0 0 6px rgb(227 169 59 / 0.15);
    color: var(--lcd-texto);
    font-family: var(--pixel);
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    line-height: 1.25;
    text-align: left;
    text-shadow: 0 0 6px rgb(227 169 59 / 0.5);
  }

  /* Reflejo del vidrio */
  .pantalla::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), transparent 35%);
    pointer-events: none;
  }

  .estado-pantalla {
    display: flex;
    justify-content: space-between;
    margin: 0 0 8px;
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--lcd-suave);
    color: var(--lcd-suave);
    font-size: 0.8em;
    text-transform: uppercase;
  }

  .salida {
    margin: 0;
  }

  .letra-actual {
    margin-right: 0.5ch;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: currentColor;
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Panel lateral: LED, altavoz, perilla ---------- */
  .panel {
    display: grid;
    justify-items: center;
    align-content: space-between;
    gap: 12px;
    width: clamp(56px, 9vw, 84px);
    padding-block: 4px;
  }

  .led {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #b07a14;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.15), 0 0 8px rgb(227 169 59 / 0.6);
  }

  .escribiendo .led {
    animation: led 0.5s steps(2) 2;
  }

  @keyframes led {
    50% {
      background: #ffd88a;
      box-shadow: 0 0 0 2px rgb(0 0 0 / 0.15), 0 0 14px #ffd88a;
    }
  }

  .rejilla {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 10px;
    background: radial-gradient(circle, rgb(0 0 0 / 0.45) 1.6px, transparent 2.2px) 0 0 / 9px 9px;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.15);
  }

  .perilla {
    display: grid;
    place-items: start center;
    width: clamp(40px, 6vw, 54px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f4efe4, #b7ab93 70%);
    box-shadow:
      0 3px 0 var(--cuerpo-sombra),
      0 6px 8px -2px rgb(0 0 0 / 0.4);
    rotate: calc(-135deg + var(--avance) * 270deg);
    transition: rotate 0.5s var(--curva);
  }

  .perilla span {
    width: 3px;
    height: 34%;
    margin-top: 10%;
    border-radius: 2px;
    background: var(--vino);
  }

  .modelo {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--texto-suave);
  }

  /* ---------- Teclas de colores, PORTA arriba y FOLIO abajo ---------- */
  .teclas {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1.6vw, 14px);
    padding: clamp(10px, 2vw, 16px);
    border-radius: 14px;
    background: rgb(0 0 0 / 0.12);
    box-shadow: inset 0 3px 6px rgb(0 0 0 / 0.25);
  }

  .tecla {
    --tapa: var(--hueso);
    --letra: var(--tinta-fija);
    position: relative;
    aspect-ratio: 1.15;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0.28), transparent 45%),
      var(--tapa);
    box-shadow:
      inset 0 -6px 0 color-mix(in srgb, var(--tapa), #000 18%),
      0 6px 0 color-mix(in srgb, var(--tapa), #000 40%),
      0 10px 12px -4px rgb(0 0 0 / 0.45);
    color: var(--letra);
    font-family: var(--display);
    font-size: clamp(1.3rem, 3.4vw, 2rem);
    font-weight: 800;
    cursor: pointer;
    translate: 0 0;
    transition:
      translate 0.08s,
      box-shadow 0.08s,
      filter 0.2s;
  }

  .tecla span {
    position: relative;
    top: -3px;
  }

  .tono-0 { --tapa: var(--vino); --letra: var(--crema-fija); }
  .tono-1 { --tapa: var(--hueso); }
  .tono-2 { --tapa: var(--oliva-claro); --letra: var(--crema-fija); }
  .tono-3 { --tapa: var(--resaltador-fijo); }
  .tono-4 { --tapa: var(--tierra); --letra: var(--crema-fija); }

  .tecla:hover {
    filter: brightness(1.06);
  }

  .tecla:active,
  .tecla.hundida {
    translate: 0 5px;
    box-shadow:
      inset 0 -3px 0 color-mix(in srgb, var(--tapa), #000 18%),
      0 1px 0 color-mix(in srgb, var(--tapa), #000 40%),
      0 3px 5px -2px rgb(0 0 0 / 0.45);
  }

  .tecla:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 4px;
  }

  /* La tecla de la última respuesta queda un poco hundida */
  .tecla.activa {
    translate: 0 3px;
    box-shadow:
      inset 0 -4px 0 color-mix(in srgb, var(--tapa), #000 18%),
      0 3px 0 color-mix(in srgb, var(--tapa), #000 40%),
      0 5px 8px -3px rgb(0 0 0 / 0.45);
  }

  /* Puntito de "ya la tocaste" */
  .tecla.vista::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 16%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
  }

  .placa {
    margin: clamp(14px, 2.4vw, 20px) 0 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  @media (max-width: 560px) {
    .frente {
      grid-template-columns: 1fr;
    }

    .panel {
      display: none;
    }

    .pantalla {
      min-height: 10em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .escribiendo .led {
      animation: none;
    }

    .aparato,
    .tecla,
    .perilla {
      transition: none;
    }
  }
</style>
