---
import Base from '../layouts/Base.astro';
import Lab from './Lab.astro';
import Contacto from './Contacto.astro';
import { textos, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<Base idioma={idioma} ruta="/lab" titulo={textos[idioma].nav.lab} descripcion={textos[idioma].lab.bajada}>
  <Lab idioma={idioma} />
  <Contacto idioma={idioma} />
</Base>
