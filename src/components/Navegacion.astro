---
import Icono from './Icono.astro';
import { enlaceContacto } from '../data/perfil';
import { rutaEn, textos, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
  ruta: string;
}

const { idioma, ruta } = Astro.props;
const t = textos[idioma].nav;
const inicio = rutaEn(idioma, '/');
const otro: Idioma = idioma === 'es' ? 'en' : 'es';

const enlaces = [
  { texto: t.trabajo, ruta: '/trabajo' },
  { texto: t.servicios, ruta: '/servicios' },
  { texto: t.lab, ruta: '/lab' },
  { texto: t.sobreMi, ruta: '/sobre-mi' },
];

const sinBarra = (r: string) => r.replace(/\/+$/, '');
const actual = sinBarra(Astro.url.pathname);
const activo = (r: string) => sinBarra(rutaEn(idioma, r)) === actual;
---

<header class="barra" data-cabecera>
  <nav class="contenedor fila" aria-label={idioma === 'es' ? 'Principal' : 'Main'}>
    <a class="marca" href={inicio} aria-label="Nakusu">
      <span class="cursor" aria-hidden="true">&gt;</span>nakusu<span class="parpadeo" aria-hidden="true">_</span>
    </a>

    <ul class="enlaces" id="menu-principal">
      {
        enlaces.map((e) => (
          <li>
            <a href={rutaEn(idioma, e.ruta)} aria-current={activo(e.ruta) ? 'page' : undefined}>
              {e.texto}
            </a>
          </li>
        ))
      }
      <!-- En el celular no caben en la barra: viven dentro del menú -->
      <li class="solo-movil separado">
        <a href={rutaEn(otro, ruta)} hreflang={otro} lang={otro}>{t.otroIdioma}</a>
      </li>
      <li class="solo-movil">
        <a class="cta" href={enlaceContacto} target="_blank" rel="noopener">{t.contacto}</a>
      </li>
    </ul>

    <div class="acciones">
      <a class="accion idioma" href={rutaEn(otro, ruta)} hreflang={otro} lang={otro}>
        <span class="largo">{t.otroIdioma}</span><span class="corto">{otro.toUpperCase()}</span>
      </a>
      <button class="accion" type="button" data-abrir-terminal aria-label="Terminal (Ctrl+K)" title="Terminal (Ctrl+K)">
        <Icono nombre="terminal-window" />
      </button>
      <button class="accion" type="button" data-tema aria-label={t.tema} title={t.tema}>
        <Icono nombre="moon" class="luna" />
        <Icono nombre="sun" class="sol" />
      </button>
      <a class="boton boton--lleno contacto" href={enlaceContacto} target="_blank" rel="noopener">{t.contacto}</a>
      <button class="accion menu" type="button" data-menu aria-expanded="false" aria-controls="menu-principal" aria-label={t.menu}>
        <Icono nombre="list" class="abrir" tamano={22} />
        <Icono nombre="x" class="cerrar" tamano={22} />
      </button>
    </div>
  </nav>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-tema]');
  const raiz = document.documentElement;

  const alternarTema = () => {
    const oscuroAhora =
      raiz.dataset.theme === 'dark' ||
      (!raiz.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const nuevo = oscuroAhora ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {}
  };

  // Como una lámpara: el tema nuevo se abre en círculo desde el botón
  boton?.addEventListener('click', () => {
    if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      alternarTema();
      return;
    }
    const caja = boton.getBoundingClientRect();
    const x = caja.left + caja.width / 2;
    const y = caja.top + caja.height / 2;
    const radio = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    raiz.classList.add('lampara');
    const transicion = document.startViewTransition(alternarTema);
    transicion.ready.then(() => {
      raiz.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radio}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.7, 0, 0.3, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    transicion.finished.finally(() => raiz.classList.remove('lampara'));
  });

  // Menú en pantallas estrechas
  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]');
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const cerrarMenu = () => {
    cabecera?.classList.remove('abierta');
    menu?.setAttribute('aria-expanded', 'false');
  };
  menu?.addEventListener('click', () => {
    const abierto = cabecera?.classList.toggle('abierta') ?? false;
    menu.setAttribute('aria-expanded', String(abierto));
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarMenu();
  });
  document.addEventListener('click', (e) => {
    if (!cabecera?.contains(e.target as Node)) cerrarMenu();
  });
</script>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1.5px solid var(--tinta);
  }

  .fila {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  .marca {
    font-family: var(--pixel);
    font-size: 1.75rem;
    line-height: 1;
    padding-block: 8px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .cursor {
    color: var(--acento);
    margin-right: 6px;
  }

  .parpadeo {
    color: var(--acento);
  }

  @media (prefers-reduced-motion: no-preference) {
    .parpadeo {
      animation: parpadeo 1.1s steps(1) infinite;
    }
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .enlaces {
    display: flex;
    gap: 4px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .enlaces a {
    display: block;
    padding: 8px 14px;
    border-radius: var(--radio);
    color: var(--texto-suave);
    font-size: 0.93rem;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .enlaces a:hover {
    color: var(--texto);
    background: var(--superficie);
  }

  /* Página actual: subrayado a mano */
  .enlaces a[aria-current='page'] {
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .enlaces + .acciones {
    margin-left: 0;
  }

  .accion {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radio);
    background: transparent;
    color: var(--texto-suave);
    font: 500 0.88rem var(--fuente);
    text-decoration: none;
    cursor: pointer;
  }

  .accion:hover {
    color: var(--texto);
    background: var(--superficie);
  }

  .corto,
  .menu,
  .solo-movil {
    display: none;
  }

  /* Muestra la luna en claro y el sol en oscuro */
  .accion :global(.sol) {
    display: none;
  }

  :global([data-theme='dark']) .accion :global(.sol) {
    display: block;
  }

  :global([data-theme='dark']) .accion :global(.luna) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .accion :global(.sol) {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .accion :global(.luna) {
      display: none;
    }
  }

  .contacto {
    padding: 10px 18px;
    margin-left: 6px;
  }

  @media (max-width: 900px) {
    .fila {
      position: relative;
      gap: 8px;
    }

    .menu {
      display: inline-grid;
      padding: 0;
    }

    .menu :global(.cerrar) {
      display: none;
    }

    .abierta .menu :global(.cerrar) {
      display: block;
    }

    .abierta .menu :global(.abrir) {
      display: none;
    }

    .enlaces {
      display: none;
      position: absolute;
      top: 100%;
      left: var(--gutter);
      right: var(--gutter);
      flex-direction: column;
      gap: 2px;
      margin: 8px 0 0;
      padding: 10px;
      border: 1.5px solid var(--tinta);
      border-radius: var(--radio);
      background: var(--fondo);
      box-shadow: 5px 5px 0 var(--tinta);
    }

    .abierta .enlaces {
      display: flex;
    }

    .enlaces a {
      padding: 12px 14px;
      font-size: 1.05rem;
    }

    .largo {
      display: none;
    }

    .corto {
      display: inline;
    }

    .contacto {
      padding: 9px 14px;
      font-size: 0.88rem;
      margin-left: 0;
    }
  }

  @media (pointer: coarse) {
    .contacto {
      min-height: 44px;
    }
  }

  /* Celular: la barra se queda con la marca, la terminal, el tema y el menú */
  @media (max-width: 560px) {
    .acciones .idioma,
    .acciones .contacto {
      display: none;
    }

    .solo-movil {
      display: block;
    }

    .separado {
      margin-top: 6px;
      padding-top: 8px;
      border-top: 1px solid var(--linea);
    }

    .enlaces .cta {
      margin-top: 6px;
      border: 1.5px solid var(--tinta);
      background: var(--texto);
      color: var(--fondo);
      font-weight: 600;
      text-align: center;
    }
  }
</style>
