---
import Repegar from './Repegar.astro';
import { funFacts, sobreMi } from '../data/contenido';
import { perfil } from '../data/perfil';
import { textos, url, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma].sobreMi;
const es = idioma === 'es';
const [entrada, ...resto] = sobreMi;

// Stickers pegados encima del código: versiones cortas de los fun facts del teclado
const pegatinas = es
  ? ['jugo de fresa > café', 'Salem y Lukas mandan', 'grunge · rock · punk', 'soy de noche', 'aprendiendo guitarra']
  : ['strawberry juice > coffee', 'Salem & Lukas rule', 'grunge · rock · punk', 'night owl', 'learning guitar'];
const tonos = ['vino', 'hueso', 'oliva', 'tierra', 'hueso'];
const giros = [-6, 4, -3, 7, -5];
// Por si cambian los fun facts: solo se muestran tantos stickers como datos haya
const visibles = pegatinas.slice(0, Math.min(pegatinas.length, funFacts.length));

// El mismo objeto del README de GitHub
const campos: [string, string][] = es
  ? [
      ['rol', '"Estudiante de Ingeniería de Software · 4.º año"'],
      ['ahora', '["Central", "Huecko", "SafeZone"]'],
      ['frontend', '["React", "TypeScript", "Tailwind", "Vite"]'],
      ['backend', '["Spring Boot", "FastAPI", "PostgreSQL"]'],
      ['tambien', '["diseño", "ilustración", "3D", "edición"]'],
      ['filosofia', '"si se ve bien y además funciona, mejor"'],
    ]
  : [
      ['role', '"Software Engineering student · 4th year"'],
      ['now', '["Central", "Huecko", "SafeZone"]'],
      ['frontend', '["React", "TypeScript", "Tailwind", "Vite"]'],
      ['backend', '["Spring Boot", "FastAPI", "PostgreSQL"]'],
      ['also', '["design", "illustration", "3D", "editing"]'],
      ['philosophy', '"if it looks good and also works, even better"'],
    ];
---

<section id="sobre-mi" class="seccion contenedor sobre">
  <div class="texto">
    <h2 class="titulo-seccion">{t.titulo}</h2>
    <p class="entrada">{entrada[idioma]}</p>
    {resto.map((p) => <p class="parrafo">{p[idioma]}</p>)}
  </div>

  <div class="collage" data-grupo-arrastre>
    {
      perfil.foto && (
        <figure class="polaroid">
          <img src={url(`/${perfil.foto}`)} alt={es ? 'Foto de Nakusu' : 'Photo of Nakusu'} width="320" height="320" loading="lazy" />
          <figcaption>{es ? 'hola, soy yo' : "hi, it's me"}</figcaption>
        </figure>
      )
    }
  <figure class="codigo" style="--i:2; --giro-cinta:3deg">
    <figcaption>whoami.ts</figcaption>
    <pre><code><span class="clave">const</span> nakusu = {'{'}
{campos.map(([k, v]) => (
  <Fragment><span class="campo">{'  '}<span class="prop">{k}</span>: <span class="valor">{v}</span>,</span>{'\n'}</Fragment>
))}{'}'};</code></pre>
  </figure>

    <ul class="pegatinas" aria-label={es ? 'Cosas de mí' : 'Things about me'}>
      {
        visibles.map((texto, i) => (
          <li class={`etiqueta etiqueta--${tonos[i]} p${i}`} data-arrastrable style={`--giro:${giros[i]}deg`}>
            {texto}
          </li>
        ))
      }
    </ul>
    <Repegar idioma={idioma} />
  </div>
</section>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  /* La primera frase grande, como entrada de revista; el resto, texto normal fácil de leer */
  .entrada {
    margin: 22px 0 0;
    max-width: 30ch;
    font-size: clamp(1.3rem, 2.1vw, 1.6rem);
    font-weight: 500;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .parrafo {
    margin: 18px 0 0;
    max-width: 46ch;
    color: var(--texto-suave);
  }

  .firma {
    margin: 22px 0 0;
    font-family: var(--script);
    font-size: 1.9rem;
    color: var(--rojo);
    width: fit-content;
  }

  /* Collage: el código abajo y los stickers pegados encima, con su sombra */
  .collage {
    position: relative;
    padding: 28px 0 48px;
  }

  .collage :global(.repegar) {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .pegatinas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pegatinas li {
    position: absolute;
    z-index: 2;
    padding: 8px 14px;
    font-size: 0.95rem;
    box-shadow:
      0 2px 0 rgb(0 0 0 / 0.15),
      0 10px 16px -8px rgb(0 0 0 / 0.45);
    cursor: grab;
  }

  .p0 { top: 0; right: 6%; }
  .p1 { top: 30%; right: -3%; }
  .p2 { bottom: 26px; left: 4%; }
  .p3 { top: -6px; left: 8%; }
  .p4 { bottom: 40px; right: 18%; }

  .polaroid {
    position: absolute;
    z-index: 1;
    top: -36px;
    left: -40px;
    width: 170px;
    margin: 0;
    padding: 10px 10px 34px;
    background: var(--crema-fija);
    box-shadow: var(--sombra);
  }

  .polaroid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .polaroid figcaption {
    margin-top: 8px;
    font-family: var(--mano);
    text-align: center;
    color: var(--tinta-fija);
  }

  .codigo {
    position: relative;
    margin: 0;
    border-radius: var(--radio);
    background: var(--tinta-fija);
    color: var(--term-texto);
    border: 1px solid var(--linea);
    overflow: hidden;
    box-shadow: var(--sombra);
  }

  figcaption {
    padding: 12px 18px;
    border-bottom: 1px solid rgb(230 226 212 / 0.1);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--term-suave);
  }

  pre {
    margin: 0;
    padding: 22px 18px 26px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: clamp(0.78rem, 1.3vw, 0.9rem);
    line-height: 1.8;
  }

  /* Celular: el código se parte en líneas en vez de obligar a deslizar de lado */
  @media (max-width: 560px) {
    pre {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    /* Sangría colgante: si un campo no cabe, la segunda línea queda debajo del valor y no en la columna 0 */
    .campo {
      display: inline-block;
      width: 100%;
      padding-left: 4ch;
      text-indent: -4ch;
    }
  }

  .clave {
    color: var(--naranja-vivo);
  }

  .prop {
    color: var(--term-acento);
  }

  .valor {
    color: var(--hueso);
  }

  @media (max-width: 860px) {
    .sobre {
      grid-template-columns: minmax(0, 1fr);
    }

    .polaroid {
      display: none;
    }
  }

  /* En celular los stickers van en fila debajo del código, sin taparlo */
  @media (max-width: 560px) {
    .pegatinas {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 22px;
    }

    .pegatinas li {
      position: static;
    }
  }
</style>
