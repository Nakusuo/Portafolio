---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Destacados from './Destacados.astro';
import ListaProyectos from './ListaProyectos.astro';
import Stack from './Stack.astro';
import Servicios from './Servicios.astro';
import Lab from './Lab.astro';
import SobreMi from './SobreMi.astro';
import Contacto from './Contacto.astro';
import { proyectosEn } from '../lib/proyectos';
import type { Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const proyectos = await proyectosEn(idioma);
const destacados = proyectos.filter((p) => p.data.destacado);
const resto = proyectos.filter((p) => !p.data.destacado);
---

<Base idioma={idioma} imagen="proyectos/paltishop.webp">
  <Hero idioma={idioma} />
  <Destacados idioma={idioma} proyectos={destacados} />
  <ListaProyectos idioma={idioma} proyectos={resto} />
  <Stack idioma={idioma} proyectos={proyectos} />
  <Servicios idioma={idioma} proyectos={proyectos} />
  <Lab idioma={idioma} />
  <SobreMi idioma={idioma} />
  <Contacto idioma={idioma} />
</Base>
