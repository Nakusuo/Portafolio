---
import Icono from './Icono.astro';
import { comoTrabajo, servicios } from '../data/contenido';
import { rutaEn, textos, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';
import { slugDe } from '../lib/proyectos';

interface Props {
  idioma: Idioma;
  proyectos: Proyecto[];
}

const { idioma, proyectos } = Astro.props;
const t = textos[idioma];
const ejemplo = idioma === 'es' ? 'Lo hice en' : 'I did it in';
const tituloDe = (slug: string) => proyectos.find((p) => slugDe(p) === slug)?.data.titulo;
const iconos = ['storefront', 'squares-four', 'app-window', 'pen-nib'];
---

<section id="servicios" class="seccion contenedor">
  <h2 class="titulo-seccion">{t.servicios.titulo}</h2>
  <p class="bajada">{t.servicios.bajada}</p>

  <div class="mesa">
    <ol class="lista" data-revelar>
      {
        servicios.map((s, i) => (
          <li>
            <Icono nombre={iconos[i]} tamano={26} class="icono" />
            <h3>{s.titulo[idioma]}</h3>
            <p>{s.detalle[idioma]}</p>
            {s.prueba && tituloDe(s.prueba) && (
              <a class="prueba" href={rutaEn(idioma, `/proyectos/${s.prueba}`)}>
                {ejemplo} {tituloDe(s.prueba)}
                <Icono nombre="arrow-right" tamano={15} />
              </a>
            )}
          </li>
        ))
      }
    </ol>

    <aside class="como-trabajo" data-revelar style="--i:2">
      <h3>{idioma === 'es' ? 'Cómo trabajo' : 'How I work'}</h3>
      <ul>
        {comoTrabajo.map((c) => <li>{c[idioma]}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .mesa {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lista li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    column-gap: 18px;
    padding: 26px 0;
    border-top: 1px solid var(--linea);
  }

  .lista li:first-child {
    border-top: 1.5px solid var(--tinta);
  }

  .lista :global(.icono) {
    grid-row: 1 / span 3;
    color: var(--acento);
    margin-top: 4px;
  }

  .lista h3 {
    grid-column: 2;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
  }

  .lista p {
    grid-column: 2;
    max-width: 52ch;
    margin-top: 8px;
    color: var(--texto-suave);
  }

  .prueba {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.93rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .prueba:hover {
    color: var(--acento);
  }

  @media (pointer: coarse) {
    .prueba {
      min-height: 44px;
    }
  }

  .como-trabajo {
    position: sticky;
    top: 100px;
    padding-top: 18px;
    border-top: 1.5px solid var(--tinta);
  }

  .como-trabajo h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .como-trabajo ul {
    display: grid;
    gap: 14px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: var(--texto-suave);
  }

  .como-trabajo li {
    padding-left: 18px;
    position: relative;
  }

  .como-trabajo li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 7px;
    height: 1.5px;
    background: var(--acento);
  }

  @media (max-width: 860px) {
    .mesa {
      grid-template-columns: minmax(0, 1fr);
    }

    .como-trabajo {
      position: static;
    }
  }
</style>
