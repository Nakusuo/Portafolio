---
import Icono from './Icono.astro';
import { gruposStack } from '../data/contenido';
import { perfil } from '../data/perfil';
import { textos, url, type Idioma } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';

interface Props {
  idioma: Idioma;
  proyectos: Proyecto[];
}

const { idioma, proyectos } = Astro.props;
const t = textos[idioma].stack;

const usadoEn = (tecnologia: string) =>
  proyectos.filter((p) => p.data.stack.includes(tecnologia)).map((p) => p.data.titulo);
---

<section id="stack" class="seccion contenedor stack">
  <div class="lateral">
    <h2 class="titulo-seccion" data-revelar><span class="prompt">&gt;</span>{t.titulo}</h2>
    <p class="bajada" data-revelar>{t.bajada}</p>
    {
      perfil.cv && (
        <a class="boton" href={url(`/${perfil.cv}`)} download data-revelar>
          <Icono nombre="file-text" tamano={18} />
          {t.cv}
        </a>
      )
    }
  </div>

  <div class="grupos">
    {
      gruposStack.map((g) => (
        <div class="grupo" data-revelar>
          <h3>{g.titulo[idioma]}</h3>
          <ul>
            {g.tecnologias.map((tec) => {
              const proyectosTec = usadoEn(tec.nombre);
              return (
                <li>
                  <Icono nombre={tec.icono} set="si" tamano={22} class="logo" />
                  <span class="nombre">{tec.nombre}</span>
                  {proyectosTec.length > 0 && (
                    <span class="usos">
                      <span class="solo-lectores">{t.usadoEn}: </span>
                      {proyectosTec.join(', ')}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stack {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .lateral {
    position: sticky;
    top: 110px;
  }

  .lateral .boton {
    margin-top: 28px;
  }

  .grupos {
    display: grid;
    gap: 44px;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--texto-suave);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--linea);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 12px;
    padding: 12px;
    border-radius: var(--radio);
    transition: background-color 0.25s;
  }

  li:hover {
    background: var(--superficie);
  }

  li :global(.logo) {
    grid-row: span 2;
    color: var(--texto-suave);
    transition: color 0.25s;
  }

  li:hover :global(.logo) {
    color: var(--acento);
  }

  .nombre {
    font-weight: 500;
  }

  .usos {
    grid-column: 2;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--texto-suave);
  }

  @media (max-width: 860px) {
    .stack {
      grid-template-columns: minmax(0, 1fr);
    }

    .lateral {
      position: static;
    }
  }
</style>
